# ── Required ────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ── Cloudinary (uploads) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Web3Forms (contact form — no SMTP needed) ───────────────
WEB3FORMS_ACCESS_KEY=

# ── Resend (password reset email — required for /api/auth/forgot-password) ──
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Optional — sender shown on the reset email. Must be a verified sender:
# a verified domain (e.g. noreply@climbpakistan.com) or the default
# onboarding@resend.dev (only delivers to the account owner's email
# until a domain is verified).
RESEND_FROM=Climb Pakistan <noreply@climbpakistan.com>

# ── Optional ────────────────────────────────────────────────
# Comma-separated allowed CORS origins (defaults to dev + production domains).
CORS_ORIGIN=
# Server port (default: 3001).
PORT=3001